[
  {
    "corsRuleName": "publicWebMedia",
    "allowedOrigins": ["*"],
    "allowedHeaders": ["range"],
    "allowedOperations": [
      "b2_download_file_by_name",
      "b2_download_file_by_id"
    ],
    "exposeHeaders": [
      "x-bz-content-sha1",
      "content-length",
      "content-range",
      "accept-ranges",
      "etag"
    ],
    "maxAgeSeconds": 86400
  }
]
